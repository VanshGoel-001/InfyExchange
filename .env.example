# InfyExchange frontend configuration — single template for dev AND prod.
#
#   dev : leave unset (or copy to `.env`) — vite.config.js proxies /api to the local
#         backend on :8000, so no base URL is needed and CORS is never exercised.
#   prod: set the GitHub Actions variable VITE_API_BASE_URL (or the Cloudflare Pages
#         build setting) instead of committing a file. Vite inlines it at BUILD time,
#         so a change always requires a redeploy — it is not read at runtime.
#
# NEVER commit a filled-in `.env` / `.env.production` (root .gitignore excludes
# `.env` and `.env.*`; this `.env.example` is the single tracked template).

# Must end with /api and must not end with a slash: the API mounts all routes under
# /api, and src/services/api.js appends its own paths (/auth/login, /listings …) to
# this base. The production build refuses a malformed value rather than shipping an
# SPA that 404s on every request.
#   production (SPA on Pages, API on Cloud Run): https://<cloud-run-host>/api
VITE_API_BASE_URL=https://api.example.com/api

# Optional: Google Sign-In. The OAuth client ID is public (it is baked into the bundle).
# Create a "Web application" client in Google Cloud Console > APIs & Services > Credentials and add
# http://127.0.0.1:5173 and your Pages origin under "Authorised JavaScript origins".
# Use the same ID for GOOGLE_CLIENT_ID on the API. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
