# Template for the production stack environment file.
# Copy to `.env` in the repository root (next to docker-compose.prod.yml) and fill
# every value. NEVER commit the filled-in file. Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Database (all required) ---
POSTGRES_USER=CHANGE_ME_db_user
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=infyexchange

# --- Application (required) ---
SECRET_KEY=CHANGE_ME_python_-c_"import_secrets;_print(secrets.token_hex(32))"
# Exact frontend origins allowed by CORS, comma-separated. Never use "*".
# Example: https://infyexchange.pages.dev,https://infyexchange.com
CORS_ORIGINS=CHANGE_ME_https://your-frontend-origin

# Optional: enforce the public Host header (recommended once the API domain is fixed)
# ALLOWED_HOSTS=api.your-domain.example

# Optional: enable HSTS only after HTTPS is verified end-to-end (see runbook)
HSTS_ENABLED=false

# --- Cloudinary (required for listing images) ---
CLOUDINARY_CLOUD_NAME=CHANGE_ME_cloud_name
CLOUDINARY_API_KEY=CHANGE_ME_api_key
CLOUDINARY_API_SECRET=CHANGE_ME_api_secret

# --- Registration policy ---
ALLOWED_EMAIL_DOMAINS=gmail.com
