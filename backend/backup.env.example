# Copy to /etc/infyexchange-backup.env on the VM and restrict it to the backup user.
# Keep the age private key off the VM; only its public recipient belongs here.
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient

# Configure this rclone remote separately with credentials stored in a protected
# rclone.conf. Use a dedicated bucket/prefix for these backups.
BACKUP_REMOTE=r2:infyexchange-backups/production
BACKUP_DIR=/var/backups/infyexchange
BACKUP_RETENTION_DAYS=14