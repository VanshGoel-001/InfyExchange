APP_NAME=InfyExchange
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/infyexchange

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

LISTING_EXPIRY_DAYS=30
MAX_IMAGES_PER_LISTING=5
MAX_IMAGE_SIZE_MB=5

# Window (seconds) in which an identical re-submission returns the existing record
DUPLICATE_SUBMISSION_WINDOW_SECONDS=60

# Comma-separated list of allowed frontend origins (must be exact scheme+host; never "*")
CORS_ORIGINS=http://localhost:4200

# Comma-separated list of allowed registration email domains
ALLOWED_EMAIL_DOMAINS=gmail.com

# --- Security headers ---
# HSTS: only enable after HTTPS coverage for the host is confirmed (see docs/security/SECURITY_RUNBOOK.md)
HSTS_ENABLED=false
HSTS_MAX_AGE=15552000
HSTS_INCLUDE_SUBDOMAINS=false

# Comma-separated hosts accepted in the Host header; leave empty to disable the check
ALLOWED_HOSTS=

# --- Rate limits (requests per window, per client IP unless noted) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CREATE=10
RATE_LIMIT_READ=120
RATE_LIMIT_CONTACT=20
RATE_LIMIT_ADMIN=60
