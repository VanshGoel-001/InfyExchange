# Local development only. Production secrets are stored in Google Secret Manager.
# Never commit the filled-in `.env`.

# ---- Required (the app will not start without these) ----
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/infyexchange
DATABASE_URL_UNPOOLED=postgresql+psycopg://postgres:postgres@localhost:5432/infyexchange
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Mode ----
ENVIRONMENT=development
APP_NAME=InfyExchange

# ---- Auth / JWT ----
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS + registration policy ----
# Exact comma-separated origins the browser may call from (never "*").
# In dev the default is fine (Vite proxies /api, so CORS is not exercised).
# Set this to the Cloudflare Pages origin in production.
CORS_ORIGINS=http://localhost:4200
ALLOWED_EMAIL_DOMAINS=gmail.com

# Optional: OAuth client ID for "Sign in with Google" (public). Empty = feature off (503).
GOOGLE_CLIENT_ID=

# ---- Optional (defaults shown; override only if needed) ----
LISTING_EXPIRY_DAYS=30
MAX_IMAGES_PER_LISTING=5
MAX_IMAGE_SIZE_MB=5
DUPLICATE_SUBMISSION_WINDOW_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Host allowlist (empty disables the check).
ALLOWED_HOSTS=
HSTS_ENABLED=false
HSTS_MAX_AGE=15552000
HSTS_INCLUDE_SUBDOMAINS=false

# Rate limits (requests per window, keyed per client IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CREATE=10
RATE_LIMIT_READ=120
RATE_LIMIT_CONTACT=20
RATE_LIMIT_ADMIN=60
