# InfyExchange backend configuration — single template for dev AND prod.
#
#   dev : copy to `.env` (this folder), set SECRET_KEY + the three CLOUDINARY_* values,
#         start the database with `docker compose --profile dev up -d`, run uvicorn.
#   prod: copy to `.env` on the host, set every CHANGE_ME value, then
#         `docker compose --profile prod up -d --build`. The prod compose builds
#         DATABASE_URL from POSTGRES_*; the DATABASE_URL line below is used only when
#         you run the API directly (e.g. in dev).
#
# NEVER commit the filled-in `.env`. Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ---- Required (the app will not start without these) ----
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/infyexchange
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Production database (read by the `prod` compose profile to build DATABASE_URL) ----
POSTGRES_USER=CHANGE_ME_db_user
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
POSTGRES_DB=infyexchange

# ---- Mode ----
ENVIRONMENT=development      # use `production` in prod: hides /docs, fails fast on bad migrations
APP_NAME=InfyExchange

# ---- Auth / JWT ----
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS + registration policy ----
# Exact comma-separated origins the browser may call from (never "*").
# In dev the default is fine (Vite proxies /api, so CORS is not exercised).
# In prod set your Vercel / Cloudflare Pages origin, e.g. https://infyexchange.pages.dev
CORS_ORIGINS=http://localhost:4200
ALLOWED_EMAIL_DOMAINS=gmail.com

# ---- Optional (defaults shown; override only if needed) ----
LISTING_EXPIRY_DAYS=30
MAX_IMAGES_PER_LISTING=5
MAX_IMAGE_SIZE_MB=5
DUPLICATE_SUBMISSION_WINDOW_SECONDS=60
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Host allowlist (empty disables the check); HSTS only after HTTPS is verified —
# see docs/security/SECURITY_RUNBOOK.md
ALLOWED_HOSTS=
HSTS_ENABLED=false
HSTS_MAX_AGE=15552000
HSTS_INCLUDE_SUBDOMAINS=false

# Rate limits (requests per window, keyed per client IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_CREATE=10
RATE_LIMIT_READ=120
RATE_LIMIT_CONTACT=20
RATE_LIMIT_ADMIN=60
